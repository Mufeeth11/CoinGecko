# Copy to .env (or export in your shell) before starting the backend.
PORT=3000
# auto = try CoinGecko then fall back to bundled mock data
# mock = always use deterministic sample data (great for offline demos)
# live = only use CoinGecko; upstream failures return HTTP 502
DATA_MODE=auto
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Optional demo key for CoinGecko's paid/demo tier
COINGECKO_API_KEY=
CACHE_TTL_MS=60000
FALLBACK_TTL_MS=60000
UPSTREAM_TIMEOUT_MS=4000
